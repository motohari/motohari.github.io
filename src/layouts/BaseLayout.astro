---
import Menu from '../components/Menu.astro';

const { 
  title, 
  description = '', 
  lang, 
  pageCss = '', 
  pageJs = '',
  ogType = 'website',
  ogImage
} = Astro.props;

// 現在のページのフルURL・日英ペアURL・OGP画像のフルURLを自動生成
const pathWithoutLang = Astro.url.pathname.replace(/^\/(ja|en)/, '') || '/';
const jaUrl = new URL(`/ja${pathWithoutLang}`, Astro.site);
const enUrl = new URL(`/en${pathWithoutLang}`, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- OGP（SNSシェア時のカード表示：ページごとに自動で切り替わる） -->
  <meta property="og:title" content={title} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- SEO対策 -->
  <meta name="google-site-verification" content="AFZeaiVwTmfgKuFx4eLQs_TfgMMRCAAED9MaBAA5OgE" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ja" href={jaUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={jaUrl} />

  <!-- 全ページ共通 -->
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/hamburger.css">
  <link rel="stylesheet" href="/transition/transition.css">
  <script src="/transition/transition.js" defer></script>

  <!-- ページ専用 -->
  {pageCss && <link rel="stylesheet" href={pageCss} />}
  {pageJs && <script src={pageJs} defer></script>}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Hina+Mincho&display=swap" rel="stylesheet">
</head>
<body>
  <Menu lang={lang} />

  <div class="content">
    <slot />
  </div>
</body>
</html>
